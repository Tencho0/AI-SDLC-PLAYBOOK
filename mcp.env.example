# MCP credentials for this engagement — copy to .env and fill in.
#
#   Copy-Item mcp.env.example .env
#   # ...fill in the values below...
#   powershell -File scripts/setup-mcp.ps1   # regenerates .mcp.json from .env
#
# This file (mcp.env.example) is committed with blank values. The real .env is
# gitignored — never commit secrets (governance guardrail 6).
#
# Leave a value blank to SKIP that server: setup-mcp.ps1 drops any server whose
# required credential is missing. Servers that need no secret (atlassian, figma,
# playwright) are always wired and use a browser OAuth / no-auth flow on first use.

# --- github (mcp__github__*) - remote hosted server, no Docker / no local install ---
# Personal Access Token from https://github.com/settings/tokens
# Minimum scopes: repo (read), read:org. Use a least-privilege, read-only token.
# NOTE: PAT is the working auth for this endpoint. Browser OAuth fails from Claude Code
# ("does not support dynamic client registration") — the hosted server needs a
# pre-registered OAuth client, which Claude Code's MCP client does not do. Use a PAT.
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- ado / Azure DevOps (mcp__ado__*) - PAT auth, no Azure CLI needed ---
# Organisation NAME only, not the full URL (e.g. contoso, not https://dev.azure.com/contoso).
AZURE_DEVOPS_ORG=
# Personal Access Token from https://dev.azure.com/<org>/_usersSettings/tokens
# Min read-only scopes: Work Items (Read), Code (Read), Project and Team (Read).
# Add Wiki (Read & Write) only if you'll publish the usage guide to the ADO wiki.
# Paste the RAW token - setup-mcp.ps1 base64-encodes it as the server requires.
AZURE_DEVOPS_PAT=

# --- teams / Microsoft 365 (mcp__teams__*) — requires an Azure AD app registration ---
# Application (client) ID and Directory (tenant) ID from the app registration.
MS365_MCP_CLIENT_ID=
MS365_MCP_TENANT_ID=
